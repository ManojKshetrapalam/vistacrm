APP_NAME="Vistabound CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://crm.vistaboundintegrated.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vistabound_crm
DB_USERNAME=vistabound_user
DB_PASSWORD=your_secure_password_here

# Sessions & Queues
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# Mail Notification Driver
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=vistaboundintegrated@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS="vistaboundintegrated@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vite Variables
VITE_APP_NAME="${APP_NAME}"
