# ==============================================================================
# Vistabound CRM — Staging Environment Template (.env.staging)
# Enforces Invariant 9: Strict Staging Isolation & Security Boundary
# ==============================================================================

APP_NAME="Vistabound CRM (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://staging-crm.vistaboundintegrated.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# Dedicated Staging Database Configuration (Invariant 9)
# MUST NOT equal 'vistabound_crm' or connect to production host 31.97.225.172
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vista_crm_staging
DB_USERNAME=vista_crm_staging_user
DB_PASSWORD=your_secure_staging_password_here

# ==============================================================================
# Web Desk Session & Security Configuration (Phase G.2.2 Stateful Session Model)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ==============================================================================
# Sanctum Stateful Domains & CORS (Staging FQDNs)
# ==============================================================================
SANCTUM_STATEFUL_DOMAINS=staging-crm.vistaboundintegrated.com,staging.myworks.sbs
CORS_ALLOWED_ORIGINS=https://staging-crm.vistaboundintegrated.com,https://staging.myworks.sbs

# ==============================================================================
# Queues & Cache
# ==============================================================================
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ==============================================================================
# Mail Notification Driver (Log only in Staging)
# ==============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging-notifications@vistaboundintegrated.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Frontend Vite Configuration
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="/api"
